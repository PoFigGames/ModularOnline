#. SourceLocation:	/ModularOnline/StringTables/ModularOnline.ModularOnline
#: /ModularOnline/StringTables/ModularOnline.ModularOnline
msgctxt "ModularOnline,Privilege.PlatformFailure"
msgid "The platform refused without giving a reason."
msgstr "The platform refused without giving a reason."

#. Key:	Privilege.VersionOutdated
#. SourceLocation:	/ModularOnline/StringTables/ModularOnline.ModularOnline
#: /ModularOnline/StringTables/ModularOnline.ModularOnline
msgctxt "ModularOnline,Privilege.VersionOutdated"
